{"nodes": [{"id": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres", "label": "ADR-0002 Queue-Isolated Connectors, Single Postgres", "file_type": "document", "source_file": "docs/03-architecture/decisions/ADR-0002-queue-isolated-connectors-single-postgres.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Vishal, Aditi", "contributor": null}, {"id": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres_queue_isolated_connectors", "label": "Queue-Isolated Connector Services", "file_type": "rationale", "source_file": "docs/03-architecture/decisions/ADR-0002-queue-isolated-connectors-single-postgres.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One connector service per tool publishing to RabbitMQ absorbs vendor outages via backoff+queue buffering (FR-1.8) and makes a new connector a new service+binding with zero core change (NFR Extensibility)."}, {"id": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres_layered_schemas", "label": "Layered Schemas (staging/core/mart)", "file_type": "rationale", "source_file": "docs/03-architecture/decisions/ADR-0002-queue-isolated-connectors-single-postgres.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single Postgres with staging/core/mart schemas; mart is fully rebuildable from staging, preserving a clean migration path to ClickHouse/warehouse without touching ingestion or the API contract."}], "edges": [{"source": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres", "target": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres_queue_isolated_connectors", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0002-queue-isolated-connectors-single-postgres.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres", "target": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres_layered_schemas", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0002-queue-isolated-connectors-single-postgres.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "layered_schema_stores", "label": "Layered Postgres Schemas (staging/core/mart)", "nodes": ["docs_03_architecture_system_architecture_staging_store", "docs_03_architecture_system_architecture_core_db", "docs_03_architecture_system_architecture_metrics_mart"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0002-queue-isolated-connectors-single-postgres.md"}]}