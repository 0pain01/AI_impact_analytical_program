{"nodes": [{"id": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology", "label": "ADR-0003 Event Envelope & Queue Topology", "file_type": "document", "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Vishal, Aditi", "contributor": null}, {"id": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_event_envelope", "label": "Event Envelope Contract", "file_type": "rationale", "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Thin envelope with raw vendor payload passthrough keeps connectors free of business logic (ADR-0002) so everything is reprocessable from staging and schema evolution never requires a connector redeploy."}, {"id": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_rabbitmq_topology", "label": "RabbitMQ Topology (aiimpacteval.events)", "file_type": "rationale", "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Topic exchange with {source}.{eventType} routing + selective consumer bindings lets connectors and consumers be added independently; DLX quarantines poison messages rather than dropping them."}, {"id": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_idempotency_key", "label": "Idempotency Key (source, sourceId, eventType)", "file_type": "rationale", "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Matches staging.raw_event unique constraint so redeliveries and backfill replays are no-ops and never double-count a metric."}], "edges": [{"source": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology", "target": "docs_03_architecture_decisions_adr_0002_queue_isolated_connectors_single_postgres", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology", "target": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_event_envelope", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology", "target": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_rabbitmq_topology", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "weight": 1.0}, {"source": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_event_envelope", "target": "docs_03_architecture_decisions_adr_0003_event_envelope_and_queue_topology_idempotency_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/03-architecture/decisions/ADR-0003-event-envelope-and-queue-topology.md", "source_location": null, "weight": 1.0}], "hyperedges": []}