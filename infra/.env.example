# Copy to .env (gitignored) and change values for anything non-local.
POSTGRES_PASSWORD=aiimpacteval_local
RABBITMQ_PASSWORD=aiimpacteval_local
# Host port for AI Impact Evaluation's Postgres (5432 is often taken by other local instances)
POSTGRES_PORT=5442

# connector-github (not containerized — runs via `mvn spring-boot:run`, so this var only
# reaches it if you source this file into your shell first; see connector-github's README).
# Read-only fine-grained PAT / App installation token. Raises the backfill rate limit from
# 60/hour (unauthenticated) to 5,000/hour — the connector still works unauthenticated, just
# rate-limited.
GITHUB_TOKEN=

# connector-jira (not containerized — same "source this file first" caveat as GITHUB_TOKEN
# above). Atlassian Cloud basic auth: JIRA_EMAIL + an API token from
# id.atlassian.com/manage-profile/security/api-tokens, read-only scope.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# connector-gitlab (containerized, ADR-0005; read_api project/group access token, Reporter role
# minimum — see connector-gitlab's README)
GITLAB_TOKEN=
# Only needed if you configure a live webhook on the GitLab project (Settings > Webhooks > Secret token).
# Leave empty to rely on backfill only.
GITLAB_WEBHOOK_SECRET=

# jenkins + connector-jenkins (both containerized, ADR-0007). JENKINS_USERNAME/API_TOKEN are for
# a real Jenkins instance's own user (Jenkins user profile -> Configure -> API Token) — the
# compose `jenkins` service ships blank/unconfigured until you complete its setup wizard once.
JENKINS_USERNAME=
JENKINS_API_TOKEN=
